# Required by docker-compose.yml. Do not use these placeholders unchanged.
# Generate the API secret with: openssl rand -hex 32
SCRAPEYARD_API_CREDENTIALS={"operator":{"secret":"replace-with-random-api-secret","scopes":["submit","read","schedule-admin","delete","health-detail"]}}

# Optional project-to-secret-name policy. Secret references are denied by default.
SCRAPEYARD_SECRET_REFERENCE_ALLOWLIST={"catalog":["SCRAPEYARD_SECRET_PROXY_URL","SCRAPEYARD_SECRET_WEBHOOK_AUTH"]}

# Generate a 32-byte base64 key with: openssl rand -base64 32
# The active ID must name one entry in SCRAPEYARD_ENCRYPTION_KEYS.
SCRAPEYARD_ENCRYPTION_KEYS={"primary-2026":"replace-with-base64-encryption-key"}
SCRAPEYARD_ENCRYPTION_ACTIVE_KEY_ID=primary-2026
