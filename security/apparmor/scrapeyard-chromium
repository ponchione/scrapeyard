# The rules of the Moby default container profile (the template in Docker
# 29.9.0), with two deliberate differences.
#
# Chromium may create unprivileged user namespaces (`userns`).
#
# The kernel gives a process every capability inside a user namespace it
# creates, whatever the container's bounding set holds, and with a network
# namespace of its own that reaches the kernel's packet sockets, netfilter,
# traffic control and the rest of what CAP_NET_ADMIN and CAP_NET_RAW open.
# AppArmor judges a capability by the profile wherever it is used, so denying
# the two here refuses them inside such a namespace as well. No browser
# sandbox uses either. The packet family is denied by name besides.
abi <abi/3.0>,

include <tunables/global>

profile "scrapeyard-chromium" flags=(attach_disconnected,mediate_deleted) {
  userns,
  network,
  deny network alg,
  deny network vsock,
  deny network packet,
  capability,
  deny capability net_admin,
  deny capability net_raw,
  file,
  umount,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer="scrapeyard-chromium",

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer="scrapeyard-chromium",
}
